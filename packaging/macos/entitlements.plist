<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for StudioCraft. The app is not sandboxed and loads no
     unsigned code. -->
<plist version="1.0">
<dict>
  <!-- Audio input sources: the hardened runtime blocks CoreAudio input without this, even after
       the user allows microphone access. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
